  "modules": [
    {
      "id": "httpdns-block",
      "name": "HTTPDNS拦截 (w0ven)",
      "description": "精准拦截列明的国内 App HTTPDNS 解析服务与 IP 解析路径，防止绕过 Surge DNS 分流，保留普通 IP 正常访问（零远端脚本）",
      "category": "网络与分流",
      "version": "2026.11.28.1",
      "notes": "纯 [Rule] + [Map Local]，零远端 JS 脚本，仅拦截明确列出的国内 App HTTPDNS 解析服务与路径，防止绕过 Surge DNS 分流。",
      "path": "surge/modules/httpdns-block.sgmodule",
      "lineCount": 96,
      "sizeBytes": 7246,
      "preview": "#!name=HTTPDNS拦截 (w0ven)\n#!desc=精准拦截列明的国内 App HTTPDNS 解析服务与 IP 解析路径，防止绕过 Surge DNS 分流，保留普通 IP 正常访问（零远端脚本）\n#!category=网络与分流\n#!version=2026.11.28.1\n\n[Rule]\nDOMAIN,yyapp-httpdns.gslb.yy.com,REJECT,extended-matching\nDOMAIN,union-httpdns.gslb.yy.com,REJECT,extended-matching\nDOMAIN,yuyin-httpdns.gslb.yy.com,REJECT,extended-matching\nDOMAIN,httpdns-v6.gslb.yy.com,REJECT,extended-matching\nDOMAIN,dns2.q2cdn.com,REJECT,extended-matching\nDOMAIN,dns.weixin.qq.com,REJECT,extended-matching\nDOMAIN,dns.weixin.qq.com.cn,REJECT,extended-matching\nDOMAIN,aedns.weixin.qq.com,REJECT,extended-matching\nDOMAIN,httpdns.kg.qq.com,REJECT,extended-matching\nDOMAIN,httpdns.browser.miui.com,REJECT,extended-matching\nDOMAIN,resolver.msg.xiaomi.net,REJECT,extended-matching\nDOMAIN,httpdns.alicdn.com,REJECT,extended-matching\nDOMAIN,httpdns-api.aliyuncs.com,REJECT,extended-matching\nDOMAIN,httpdns-sc.aliyuncs.com,REJECT,extended-matching\nDOMAIN,amdc.alipay.com,REJECT,extended-matching\nDOMAIN,ucdc.upaas.quark.cn,REJECT,extended-matching\nDOMAIN,httpdns.danuoyi.tbcache.com,REJECT,extended-matching\nDOMAIN,xpis-xcdn.youku.com,REJECT,extended-matching"
    }
  ],
